# Copy to .env and fill in. Never commit the real .env file.

# Fully local LLM via Ollama — no API key needed. Install Ollama (https://ollama.com),
# run `ollama pull qwen2.5:7b-instruct` (or another model), and make sure the Ollama
# app/daemon is running. Uncomment to override the defaults below.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b-instruct

# SQLite file path, relative to backend/ working directory
DATABASE_URL=sqlite:///../data/db/legal_lens.db

# ChromaDB persistence directory
VECTOR_STORE_DIR=../data/vector_store

# Local evidence file storage directory
EVIDENCE_STORE_DIR=../data/evidence
